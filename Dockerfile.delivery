# syntax=docker/dockerfile:1
#
# Public content delivery edge (ADR-004). This is the only internet-facing
# image in the platform: it holds the DELIVERY signing key and never the main
# one, so a compromise of this container cannot mint anything but read-only,
# published-only, tenant-scoped credentials.

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache ca-certificates git

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/delivery ./apps/delivery/cmd/delivery

FROM alpine:3.20

RUN apk add --no-cache ca-certificates wget \
    && adduser -D -H -u 10001 appuser

WORKDIR /app

COPY --from=builder /out/delivery /app/delivery

USER appuser

EXPOSE 4100

ENTRYPOINT ["/app/delivery"]
