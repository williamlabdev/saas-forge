# Production-oriented example — copy and adapt (never commit real secrets).
# Generate: openssl rand -hex 32

# --- Database (managed Postgres recommended) ---
DATABASE_URL=postgres://USER:PASSWORD@your-host:5432/users?sslmode=require
# Self-hosted alternative, using deploy/docker-compose.prod.yml's bundled
# `postgres` service (see POSTGRES_* near the bottom of this file) instead of
# a managed instance:
# DATABASE_URL=postgres://app:REPLACE_WITH_RANDOM_SECRET@postgres:5432/app?sslmode=disable

HTTP_ADDR=:8080

# --- Environment (required in production) ---
# Arms hard startup guards: the server REFUSES to boot with dev headers or
# AUTHZ_MODE=allow when APP_ENV=production (TKT-R2).
APP_ENV=production

# --- AuthN / AuthZ (required) ---
AUTHZ_MODE=rbac
# AUTHZ_MODE=opa

# Decision log: every authorization call is normalised and logged via slog
# (internal/pkg/authz/decision_logger.go). off = nothing; deny = refusals and
# evaluation errors only (this default); all = also logs allows, at DEBUG,
# rate-capped to 100/s per process (AllowSampler) so a hot path cannot flood
# the log. Unknown values refuse to start, same as an unknown AUTHZ_MODE.
AUTHZ_DECISION_LOG=deny
# AUTHZ_DECISION_LOG=off
# AUTHZ_DECISION_LOG=all

AUTH_DEV_HEADERS=false

JWT_SECRET_HEX=REPLACE_WITH_64_HEX_CHARS
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# In-process limiter: the effective ceiling is replicas x limit.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SEC=60

# --- Gateway guard (recommended) ---
# Same value here and on every edge (bff / delivery / cmsmcp). The domain API
# then rejects anything that reaches :8080 without a matching X-Gateway-Secret.
# Empty disables the guard entirely - only do that if mTLS or a hard network
# boundary does the same job. Your gateway must strip client-supplied copies.
GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET

# Leave unset unless a proxy you control strips client-supplied X-Forwarded-For.
# Safe to set true when deploy/Caddyfile is the edge: it REPLACES
# X-Forwarded-For on every route (`header_up X-Forwarded-For {http.request.remote.host}`)
# rather than appending to a client-supplied one.
TRUST_PROXY_HEADERS=true

# --- Crypto (required) ---
ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARS
BLIND_INDEX_PEPPER_HEX=REPLACE_WITH_64_HEX_CHARS

# --- Agents (ADR-013) ---
# Unset means one agent credential may call the domain API as fast as it likes.
AGENT_RATE_LIMIT=120
AGENT_RATE_WINDOW_SEC=60
AGENT_TOKEN_TTL_DAYS=30

# --- Public delivery edge (apps/delivery; omit the whole block if unused) ---
# Its OWN key, >= 64 hex chars, and it MUST differ from JWT_SECRET_HEX -
# production refuses to start if they match. This process faces the internet.
DELIVERY_JWT_SECRET_HEX=REPLACE_WITH_64_HEX_CHARS
DELIVERY_TOKEN_TTL_SECONDS=120
# Must be > 0 - the edge refuses to start otherwise.
DELIVERY_RATE_LIMIT=600
DELIVERY_RATE_WINDOW_SECONDS=60
# 0 = public, no-cache (revalidated against a strong ETag, so an unpublish takes
# effect on the next request). Any positive value is staleness you cannot purge.
DELIVERY_CACHE_MAX_AGE_SECONDS=0

# --- CMS MCP server (apps/cmsmcp; omit the whole block if unused) ---
# stdio mode only. It MUST be an agent credential from
# POST /api/v1/auth/agent-tokens - a human access token makes every
# agent-specific control inert while still appearing to work.
# In HTTP mode (CMS_MCP_HTTP_ADDR set) this must NOT be set.
# CMS_AGENT_TOKEN=<agent token>
# CMS_MCP_HTTP_ADDR=:4200

# --- Media storage (private bucket; presigned URLs only) ---
MEDIA_S3_ENDPOINT=s3.your-region.amazonaws.com
MEDIA_S3_BUCKET=your-media-bucket
MEDIA_S3_REGION=your-region
MEDIA_S3_USE_SSL=true
MEDIA_S3_ACCESS_KEY=REPLACE
MEDIA_S3_SECRET_KEY=REPLACE
# The browser dereferences presigned URLs directly, so if the server-side
# endpoint above is not reachable from the browser (self-hosted MinIO behind
# Caddy: MEDIA_S3_ENDPOINT=minio:9000 is a compose-network name), set the
# public equivalent here. Unset = same as MEDIA_S3_ENDPOINT (real S3/R2 needs
# no change; leave commented out).
# MEDIA_S3_PUBLIC_ENDPOINT=media.your-domain.example
# MEDIA_S3_PUBLIC_USE_SSL=true

# --- BFF ---
BFF_CORS_ORIGINS=https://console.your-domain.example
BFF_PLAYGROUND=false

# --- MCP / outbox ---
# Empty means outbox deliveries go to a no-op client: events look delivered
# and are not.
MCP_BASE_URL=https://mcp.your-domain.example
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=10

# --- Scheduled publish (ADR-017) ---
# How often the worker looks for schedules that came due. This IS the accuracy
# of a scheduled publish: 30s means "08:00" lands somewhere in 08:00:00-08:00:30.
# A Go duration ("30s", "1m"), not a count of seconds.
SCHEDULE_POLL_INTERVAL=30s

# --- Media transforms (ADR-019) ---
# How often the worker looks for images whose thumbnails are still pending.
# This is the upload-to-thumbnail latency an editor sees; delivery serves the
# original in the meantime. Go duration. Ignored when MEDIA_S3_* is unset.
MEDIA_TRANSFORM_POLL_INTERVAL=15s

# --- Observability ---
METRICS_ENABLED=true
# Optional: require Bearer token for GET /metrics (recommended in prod)
METRICS_BEARER_TOKEN=REPLACE_WITH_RANDOM_SECRET

# --- Bootstrap (one-time; remove after admin assigned) ---
# BOOTSTRAP_ADMIN_USER_ID=<uuid>

# --- Reverse proxy (deploy/Caddyfile / deploy/docker-compose.prod.yml) ---
# Public domains Caddy terminates TLS for and routes by Host header.
API_DOMAIN=api.your-domain.example
DELIVERY_DOMAIN=cdn.your-domain.example
CONSOLE_DOMAIN=console.your-domain.example
# Only used if you enable the `minio` compose profile AND uncomment its site
# block in deploy/Caddyfile — most deployments use real object storage and
# leave this unset.
# MEDIA_DOMAIN=media.your-domain.example
# Contact address Caddy gives Let's Encrypt for expiry notices / ACME account.
ACME_EMAIL=ops@your-domain.example
# "" (unset/empty) = automatic HTTPS via ACME (real deployments). "internal"
# = Caddy's local self-signed CA, no ACME lookups — used by the local restore
# drill and any environment without a publicly resolvable domain.
CADDY_TLS_MODE=
# Host ports Caddy binds; change only to avoid a collision with something
# else already on 80/443 on this host.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Built console SPA assets Caddy serves as static files (see console repo's
# build output). Path is relative to deploy/ when not absolute.
CONSOLE_DIST=./console-dist
# Prebuilt image tag/registry prefix (see docker-compose.prod.yml's `image:`
# lines). IMAGE_PREFIX defaults to `saas-platform` (built locally from this
# repo's Dockerfiles). IMAGE_TAG has no default in the compose file itself —
# `latest` silently drifts, so compose refuses to start without it — but the
# `make prod-*` targets fill in the current commit's short git sha when it is
# unset in the environment, so leaving this commented out is fine for local
# use; set it explicitly for a real deployment (e.g. a CI-built tag).
# IMAGE_PREFIX=your-registry.example/saas-platform
# IMAGE_TAG=REPLACE_WITH_A_REAL_TAG_OR_GIT_SHA
# Pinning IMAGE_TAG here (rather than leaving it to the fallback below) is
# the recommended setup for cron-driven deploy/backup.sh, restore.sh and
# restore-drill.sh (see deploy/cron.example) — docker compose interpolates
# every service's image: line even for these scripts' postgres-only calls,
# and cron has no shell to compute one. Left unset, those scripts fall back
# to the checkout's current git short sha, and if `git` is unavailable, to a
# fixed placeholder — harmless for them since none pulls or starts app/bff/
# etc., but still worth pinning explicitly so a real deploy's `make prod-up`
# and its cron backups are provably using the same tag.

# --- Self-hosted Postgres (deploy/docker-compose.prod.yml's `postgres`
# service; skip if DATABASE_URL above points at managed Postgres instead) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=app

# --- Backups (deploy/backup.sh, deploy/restore.sh, deploy/restore-drill.sh) ---
# BACKUP_DIR=/var/backups/saas-platform
BACKUP_KEEP_DAYS=14
# Shell command copying media into $BACKUP_MEDIA_DEST, e.g.:
# BACKUP_MEDIA_CMD=mc mirror --overwrite local/your-media-bucket "$BACKUP_MEDIA_DEST"
# BACKUP_MEDIA_CMD=
# Shell command restoring media FROM $BACKUP_MEDIA_SRC, mirroring the command above.
# BACKUP_MEDIA_RESTORE_CMD=

# --- Alerting (deploy/healthwatch.sh, deploy/cron.example) ---
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/XXX
DISK_MIN_FREE_PCT=15
