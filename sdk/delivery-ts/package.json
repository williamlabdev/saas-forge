{
  "name": "@saas-platform/delivery-client",
  "version": "0.1.0",
  "description": "Typed client for the SaaS Platform content delivery API (apps/delivery).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "openapi-typescript ../../apps/delivery/openapi/delivery.yaml -o src/generated/openapi.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
