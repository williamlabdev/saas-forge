# Copy to .env before: docker compose up --build
# Generate keys: openssl rand -hex 32

POSTGRES_USER=app
# DEV-ONLY THROWAWAY (publicly known from this file) — generate your own for
# anything beyond local dev: openssl rand -hex 32
POSTGRES_PASSWORD=app
POSTGRES_DB=users
POSTGRES_PORT=5433

# DATABASE_URL is derived in docker-compose.yml from POSTGRES_USER/PASSWORD/DB —
# set it only to override (rotating POSTGRES_PASSWORD then needs no second edit).
# DATABASE_URL=postgres://app:app@postgres:5432/users?sslmode=disable
HTTP_ADDR=:8080

# APP_ENV defaults to "production" in code, which makes the hard startup guards
# the default: AUTHZ_MODE=allow and AUTH_DEV_HEADERS=true both refuse to boot.
# This line is what disarms them for local development. Delete it (or set
# production) and the server fails closed instead of warning.
APP_ENV=development
AUTHZ_MODE=allow
# AUTHZ_MODE=rbac|opa  (opa uses embedded Rego + IAM facts)

# REQUIRED — compose has no baked-in fallbacks (TKT-R3); missing = fail-fast.
# The values below are DEV-ONLY THROWAWAYS, publicly known from this file.
# For anything beyond local dev, generate your own: openssl rand -hex 32
JWT_SECRET_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Agent credentials get their own lifetime (ADR-013). They are long because an
# agent runs unattended — it has no refresh path and nobody to log it back in,
# so the 15-minute access TTL above meant losing the credential four times an
# hour. That is only safe because an agent credential is REVOCABLE: every one
# has a row in agent_credentials, and the middleware refuses a token whose row
# is revoked, expired or gone. Unset falls back to the access TTL, not to a
# month — "not configured" reads as the narrower answer.
AGENT_TOKEN_TTL_DAYS=30
# Public content delivery edge (ADR-004). Signs/verifies ONLY delivery
# credentials (read-only, published-only, one tenant). It MUST differ from
# JWT_SECRET_HEX — the edge is internet-facing, and a shared key would let a
# compromised edge mint owner tokens. Production refuses to start if they match.
# Leave unset to keep the delivery feature off entirely; there is no single-key
# fallback by design. The value below is a DEV-ONLY THROWAWAY.
DELIVERY_JWT_SECRET_HEX=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
DELIVERY_HTTP_ADDR=:4100
DELIVERY_RATE_LIMIT=600
DELIVERY_RATE_WINDOW_SECONDS=60
# 0 = revalidate-always: `public, no-cache` + 強 ETag,unpublish 在下一個請求就
# 生效(ADR-011)。>0 的語意是「操作者明確接受 N 秒的過期暴露」,只有在 CDN
# 前置且有訂閱 content.* 的 purge 消費者時才是正當姿態 —— 這個範本不預設它,
# 否則每個照著複製的環境都會靜默回到本來要修掉的那個模式。
DELIVERY_CACHE_MAX_AGE_SECONDS=0

# Media object storage (ADR-005). S3-compatible — the same four vars point at
# MinIO (dev, below), AWS S3, Cloudflare R2 or Backblaze B2. The bucket is
# PRIVATE: reads are served through short-lived signed URLs, so unpublishing an
# entry revokes access once the outstanding URLs expire.
# Leave MEDIA_S3_ENDPOINT empty to turn the media feature off (endpoints 501).
MEDIA_S3_ENDPOINT=minio:9000
MEDIA_S3_BUCKET=media
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_USE_SSL=false
AUTH_DEV_HEADERS=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SEC=60
# Per-agent rate limit (ADR-013 補裁 S-2 題一). Requests per window for ONE
# agent credential, keyed by tenant + agent name — so rotating a credential
# does not hand the same agent a fresh budget, and one agent cannot spend
# another's. Humans are not affected.
#
# UNSET (0) = no cap, and that is the shipped default ON PURPOSE. The limiter
# is in-process (ratelimit/ip_limiter.go: "Redis in M1", which never landed),
# so under N replicas the real ceiling is N × this number. A default here would
# publish a figure the system does not enforce; pick one that suits YOUR replica
# count, and do not quote it as a guarantee to callers. Startup warns when unset.
# AGENT_RATE_LIMIT=120
# AGENT_RATE_WINDOW_SEC=60
METRICS_ENABLED=true
# BOOTSTRAP_ADMIN_USER_ID=<uuid-after-first-register>
# With docker compose (default): MCP mock on :8081
MCP_BASE_URL=http://mcp:8081
OUTBOX_POLL_SECONDS=2
# OUTBOX_BATCH_SIZE=10

# REQUIRED (dev-only throwaways — same caveat as JWT_SECRET_HEX above).
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BLIND_INDEX_PEPPER_HEX=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# --- CMS MCP server (ADR-013 step 6) --------------------------------------
# The agent-facing transport adapter. Empty CMS_MCP_HTTP_ADDR = stdio transport
# (an MCP client launches the binary); a value = streamable HTTP on that port,
# which is what docker compose runs.
CMS_MCP_HTTP_ADDR=:4200
# Page sizes for agent reads (ADR-013 §7). Much smaller than a human UI's,
# because the model's context is the scarce resource.
CMS_MCP_DEFAULT_LIMIT=10
CMS_MCP_MAX_LIMIT=50
# CMS_AGENT_TOKEN is for stdio mode ONLY and must be an AGENT credential.
#
# Two warnings, both of which fail silently:
#   1. In HTTP mode this must be unset — each caller brings its own bearer, and
#      a process-wide token would answer for callers that sent none. The server
#      refuses to start with both, which is the one part that is not silent.
#   2. Handing it an ordinary human access token WORKS, and that is the danger:
#      every ADR-013 narrowing (the type whitelist, the scope refusals, agent
#      provenance) keys off the credential being an agent one, so a human token
#      turns all of it off while the tools keep answering.
# Mint one with: POST /api/v1/auth/agent-tokens (owner/admin of the tenant),
# body {"agent_id":"...","allowed_types":["post",...]}. The token comes back
# ONCE and is never stored, so it cannot be shown again. List them with GET on
# the same path; turn one off with DELETE /api/v1/auth/agent-tokens/{id}, which
# takes effect on the credential's very next request.
# CMS_AGENT_TOKEN=

# Trust X-Forwarded-For for client IP (rate limiting / audit).
# Keep false unless a proxy in front strips client-supplied values.
TRUST_PROXY_HEADERS=false
